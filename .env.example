# PostgreSQL connection for the intelligence service (disposable test DB during development).
#
# REV-034: migration 1025 creates the runtime roles. `swi_legacy_runtime` is the
# role this binary is meant to run as: it holds USAGE on the `swi_legacy` archive
# schema plus DML on `public`, and it does NOT hold EXECUTE on
# `transition_intent()` (that grant belongs to the transition owner). Running as
# `postgres` bypasses every one of those boundaries, so the superuser URL is only
# valid for migrating and for the disposable local test database.
#
# Set a password for the role before using this URL:
#   ALTER ROLE swi_legacy_runtime WITH LOGIN PASSWORD '...';
# (1025 creates it NOLOGIN on purpose — an unused role must not be reachable.)
DATABASE_URL=postgres://swi_legacy_runtime:CHANGE_ME@localhost:5432/whale_intel

# Privileged credentials used ONLY by `swi db migrate` (DDL + role creation).
#
# REV-035-#1: previously every startup path — including `swi run` — called
# db::migrate() on the runtime pool, so the runtime role above made the service die
# with `permission denied for schema public`. Service commands now only VERIFY the
# schema is current (a read-only SELECT on public._migrations) and refuse to start
# when it is behind. Applying DDL happens here, deliberately.
#
# If unset, `db migrate` falls back to DATABASE_URL for single-role development.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/whale_intel

# Helius API keys (user-owned only; add HELIUS_KEY_2..N as needed)
HELIUS_KEY_1=

# GMGN Agent API key (query-only enrichment; never a trading key)
GMGN_API_KEY=

# Telegram MTProto app credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
# Encrypted session file stored OUTSIDE the repository
TG_SESSION_PATH=C:/Users/CHANGE_ME/tg-session.bin

# Telegram Bot API (outbound research alerts only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Robinhood Chain (Arbitrum Orbit L2) shares the Helius account: its EVM RPC
# endpoint derives from [helius].base_url + [chains.robinhood].helius_slug in
# config.toml and authenticates with HELIUS_KEY_1. No separate RPC env var.
