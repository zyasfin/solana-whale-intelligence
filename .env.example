# PostgreSQL connection for the intelligence service (disposable test DB during development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whale_intel

# Helius and GMGN API keys are managed in the admin API panel (stored in the
# helius_keys / gmgn_keys tables); no key env vars are read at runtime.

# Telegram MTProto app credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
# Encrypted session file stored OUTSIDE the repository
TG_SESSION_PATH=C:/Users/CHANGE_ME/tg-session.bin

# Telegram Bot API (outbound research alerts only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Robinhood Chain (Arbitrum Orbit L2) shares the Helius account: its EVM RPC
# endpoint derives from [helius].base_url + [chains.robinhood].helius_slug in
# config.toml and authenticates with a key from the admin API panel. No separate RPC env var.
